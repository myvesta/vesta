#!/bin/bash
# info: update BunnyCDN edge server IP list for nginx
# options: NONE
#
# The function downloads the current BunnyCDN edge server list (IPv4 and IPv6)
# and writes /etc/nginx/conf.d/bunny.conf with a geo block of Bunny edges and
# a map that sets $client_ip to the visitor IP (X-Real-IP) only when the
# request comes from a Bunny edge AND carries the correct X-Bunny-Auth secret.
# Requests from Bunny pull zones that do not know the secret keep the edge IP,
# so nobody can spoof a visitor IP through their own Bunny account.
# nginx is reloaded only if the file changed. Called daily from cron.


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

# Importing system environment as we run this script
# mostly by cron which do not read it by itself
source /etc/profile

# Includes
source $VESTA/func/main.sh
source $VESTA/conf/vesta.conf

CONF="/etc/nginx/conf.d/bunny.conf"
SECRET_FILE="$VESTA/conf/bunnycdn.secret"
MIN_V4=50
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT

fetch() {
    curl -fsS --max-time 30 -H "Accept: application/json" "$1" | tr -d '[]" \r' | tr ',' '\n'
}


#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ ! -f "/etc/nginx/nginx.conf" ]; then
    echo "Error: nginx is not installed"
    exit $E_NOTEXIST
fi

if [ ! -s "$SECRET_FILE" ]; then
    echo "Error: $SECRET_FILE not found, run v-add-sys-bunnycdn first"
    exit $E_NOTEXIST
fi
SECRET=$(tr -cd 'A-Za-z0-9' < "$SECRET_FILE")
if [ ${#SECRET} -lt 32 ]; then
    echo "Error: secret in $SECRET_FILE is too short (min 32 alphanumeric characters)"
    exit $E_INVALID
fi


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

V4=$(fetch "https://bunnycdn.com/api/system/edgeserverlist" | grep -E '^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?$' | sort -u)
V6=$(fetch "https://bunnycdn.com/api/system/edgeserverlist/ipv6" | grep -E '^[0-9a-fA-F:]+(/[0-9]{1,3})?$' | grep ':' | sort -u)

COUNT_V4=$(printf "%s\n" "$V4" | grep -c .)
COUNT_V6=$(printf "%s\n" "$V6" | grep -c .)

if [ "$COUNT_V4" -lt "$MIN_V4" ]; then
    echo "Error: IPv4 list suspiciously small ($COUNT_V4 entries), skipping update"
    logger -t bunny-realip "IPv4 list suspiciously small ($COUNT_V4 entries), skipping update"
    exit $E_CONNECT
fi

{
    echo "# BunnyCDN real visitor IP, generated by v-update-sys-bunnycdn-ips, do not edit manually"
    echo "geo \$bunny_edge {"
    echo "    default 0;"
    printf "%s\n" "$V4" | grep . | sed 's/^/    /; s/$/ 1;/'
    printf "%s\n" "$V6" | grep . | sed 's/^/    /; s/$/ 1;/'
    echo "}"
    echo ""
    echo "map \"\$bunny_edge:\$http_x_bunny_auth\" \$client_ip {"
    echo "    default \$remote_addr;"
    # Regex key: avoids map_hash_bucket_size limits with a long secret
    echo "    \"~^1:$SECRET\$\" \$http_x_real_ip;"
    echo "}"
} > "$TMP"

# No change, no reload
if [ -f "$CONF" ] && cmp -s "$TMP" "$CONF"; then
    exit $OK
fi

[ -f "$CONF" ] && cp -a "$CONF" "$CONF.bak"
install -m 600 "$TMP" "$CONF"

if nginx -t > /dev/null 2>&1; then
    systemctl reload nginx
    logger -t bunny-realip "Updated: $COUNT_V4 IPv4 + $COUNT_V6 IPv6, nginx reloaded"
else
    logger -t bunny-realip "nginx -t failed, restoring previous list"
    if [ -f "$CONF.bak" ]; then mv -f "$CONF.bak" "$CONF"; else rm -f "$CONF"; fi
    echo "Error: nginx -t failed, previous list restored"
    exit $E_RESTART
fi


#----------------------------------------------------------#
#                       Vesta                              #
#----------------------------------------------------------#

exit $OK
