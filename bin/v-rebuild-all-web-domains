#!/bin/bash
# info: rebuild all web domains
# options: NONE
#
# The function rebuilds all web configuration files.

if [ -z "$VESTA" ]; then
    export VESTA="/usr/local/vesta"
fi

source /usr/local/vesta/func/main.sh

services_list=$(/usr/local/vesta/bin/v-list-sys-services)

has_nginx_running=0;
has_apache2_running=0;

has_nginx=$(check_if_service_exists "nginx")
has_apache2=$(check_if_service_exists "apache2")

if [ "$has_nginx" == "1" ]; then
    has_nginx_running=$(check_if_service_is_running "nginx")
fi
if [ "$has_apache2" == "1" ]; then
    has_apache2_running=$(check_if_service_is_running "apache2")
fi

for user in $(grep '@' /etc/passwd |cut -f1 -d:); do
    if [ ! -f "/usr/local/vesta/data/users/$user/user.conf" ]; then
        continue;
    fi
    /usr/local/vesta/bin/v-rebuild-web-domains $user 'no'
done

EXIT_CODE1=0
EXIT_CODE2=0

if [ "$has_nginx" == "1" ] && [ "$has_nginx_running" == "1" ]; then
    systemctl restart nginx
    EXIT_CODE1=$?
    if [ $EXIT_CODE1 -ne 0 ]; then
        check_error $EXIT_CODE1 "'systemctl restart nginx' failed"
    else
        echo "== Nginx restarted successfully"
    fi
else
    echo "has_nginx:         $has_nginx"
    echo "has_nginx_running: $has_nginx_running"
    echo "== Nginx is not restarted"
fi

if [ "$has_apache2" == "1" ] && [ "$has_apache2_running" == "1" ]; then
    systemctl restart apache2
    EXIT_CODE2=$?
    if [ $EXIT_CODE2 -ne 0 ]; then
        check_error $EXIT_CODE2 "'systemctl restart apache2' failed"
    else
        echo "== Apache2 restarted successfully"
    fi
else
    echo "has_apache2:         $has_apache2"
    echo "has_apache2_running: $has_apache2_running"
    echo "== Apache2 is not restarted"
fi

if [ $EXIT_CODE1 -eq 0 ] && [ $EXIT_CODE2 -eq 0 ]; then
    exit 0
else
    exit $EXIT_CODE1
fi
