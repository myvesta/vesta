#!/bin/bash
# info: list firewall block list
# options: [FORMAT]
#
# The function of obtaining the list of currently blocked ips.


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
source $VESTA/func/main.sh

BANLIST_FILE=$VESTA/data/firewall/banlist.conf
release=$(/usr/local/vesta/bin/v-get-debian-version)
if [ "$release" -gt 12 ]; then
    BANLIST_FILE=$VESTA/data/firewall/banlist_temp.conf
    touch $VESTA/data/firewall/banlist.conf
    cat $VESTA/data/firewall/banlist.conf > $BANLIST_FILE
fi

# JSON list function
json_list() {
    IFS=$'\n'
    i=1
    objects=$(grep IP $BANLIST_FILE |wc -l)
    echo "{"
    while read str; do
        eval $str
        echo -n '    "'$IP'": {
        "IP": "'$IP'",
        "CHAIN": "'$CHAIN'",
        "TIME": "'$TIME'",
        "DATE": "'$DATE'"
    }'
        if [ "$i" -lt "$objects" ]; then
            echo ','
        else
            echo
        fi
        ((i++))
    done < <(cat $BANLIST_FILE)
    echo '}'
}

# SHELL list function
shell_list() {
    IFS=$'\n'
    echo "IP   CHAIN   TIME   DATE"
    echo "--   -----   ----   ----"
    while read str; do
        eval $str
        echo "$IP $CHAIN $TIME $DATE"
    done < <(cat $BANLIST_FILE)
}

# PLAIN list function
plain_list() {
    IFS=$'\n'
    while read str; do
        eval $str
        echo -e "$IP\t$CHAIN\t$TIME\t$DATE"
    done < <(cat $BANLIST_FILE)
}

# CSV list function
csv_list() {
    IFS=$'\n'
    echo "IP,CHAIN,TIME,DATE"
    while read str; do
        eval $str
        echo "$IP,$CHAIN,$TIME,$DATE"
    done < <(cat $BANLIST_FILE)
}


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ "$release" -gt 12 ]; then
    jails=$(fail2ban-client status | sed -n 's/.*Jail list:[[:space:]]*//p' | tr ',' ' ')

    for jail in $jails; do
        ips=$(fail2ban-client get "$jail" banip)

        for ip in $ips; do
            echo "IP='$ip' CHAIN='$jail' TIME='' DATE=''" >> "$BANLIST_FILE"
        done
    done
fi

# Listing data
case $format in
    json)   json_list ;;
    plain)  plain_list ;;
    csv)    csv_list ;;
    shell)  shell_list |column -t ;;
esac


#----------------------------------------------------------#
#                       Vesta                              #
#----------------------------------------------------------#

exit
