#!/bin/bash
# info: delete firewall blocking rule
# options: IP CHAIN
#
# The function deletes blocking rule from system firewall


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

release=$(/usr/local/vesta/bin/v-get-debian-version)

# Importing system variables
source /etc/profile

# Argument definition
ip=$1
if [ "$release" -lt 13 ]; then
    chain=$(echo $2|tr '[:lower:]' '[:upper:]')
else
    chain=$(echo $2|tr '[:upper:]' '[:lower:]')
    if [ "$chain" = "web" ]; then
        chain="WEB";
    fi
fi

# Defining absolute path for iptables and modprobe
iptables="/sbin/iptables"

# Includes
source $VESTA/func/main.sh
source $VESTA/conf/vesta.conf


#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'IP CHAIN'
is_format_valid 'ip' 'chain'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

run_legacy_code=0;

if [ "$release" -gt 12 ]; then
    if [ "$chain" = "WEB" ]; then
        run_legacy_code=1;
    else
       run_legacy_code=1;
    fi
fi

if [ "$release" -gt 12 ]; then
    if [ "$chain" != "WEB" ]; then
        fail2ban-client set $chain unbanip $ip
        log_event "$OK" "$ARGUMENTS"
        exit 0;
    fi
fi

if [ $run_legacy_code -eq 0 ]; then
    exit 0;
fi

skip_iptables_ban=0;
if [ $ip_is_ipv6 -eq 1 ]; then
    skip_iptables_ban=1;
fi
if [ ! -z "$WEB_FAIL2BAN_ONLY_NGINX" ] && [ "$chain" = "WEB" ]; then
    skip_iptables_ban=1;
fi

# Checking ip in banlist
conf="$VESTA/data/firewall/banlist.conf"
check_ip=$(grep "IP='$ip' CHAIN='$chain'" $conf 2>/dev/null)
if [ -z "$check_ip" ]; then
    exit 1; # IP not found in banlist
fi

# Deleting ip from banlist
sip=$(echo "$ip"| sed "s|/|\\\/|g")
sed -i "/IP='$sip' CHAIN='$chain'/d" $conf

if [ $skip_iptables_ban -eq 0 ]; then
    b=$($iptables -L fail2ban-$chain --line-number -n|grep $ip|awk '{print $1}')
    $iptables -D fail2ban-$chain $b 2>/dev/null
fi

# Changing permissions
chmod 660 $conf

# nginx deny rules conf
if [ "$chain" = "WEB" ] && [ -f "/etc/nginx/conf.d/block.conf" ]; then
    sed -i "/deny $ip;/d" /etc/nginx/conf.d/block.conf
    systemctl reload nginx
fi

#----------------------------------------------------------#
#                       Vesta                              #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit 0;
