[sshd]
enabled = true
maxretry = 5

[exim-iptables]
enabled = true
filter  = exim
port    = 25,465,587,2525,110,995,143,993
logpath = /var/log/exim4/mainlog

[dovecot-iptables]
enabled = true
filter  = dovecot
port    = 25,465,587,2525,110,995,143,993
logpath = /var/log/dovecot.log

[dovecot-missing-passwd]
enabled = true
filter  = dovecot-missing-passwd
port    = 25,465,587,2525,110,995,143,993
logpath = /var/log/dovecot.log

[mysqld-iptables]
enabled  = false
filter   = mysqld-auth
port     = 3306
logpath  = /var/log/mysql.log
maxretry = 5

[vesta-iptables]
enabled = true
filter  = vesta
port    = 8083
logpath = /var/log/vesta/auth.log
maxretry = 5
